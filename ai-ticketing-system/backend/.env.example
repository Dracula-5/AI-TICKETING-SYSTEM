# SQLite (default, zero-setup local dev):
DATABASE_URL=sqlite:///./tickets.db
# Postgres (used by docker-compose.yml / production):
# DATABASE_URL=postgresql://ticketing:change-me-in-production@localhost:5432/ticketing

SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1800
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Populate the DB with fake vendors/products/customers on startup (Faker-based).
# Dev/demo only — never enable this against a real production database.
SEED_MARKETPLACE_DEMO_DATA=false

# Optional: enables LLM-assisted vendor auto-negotiation (falls back to the
# rule-based negotiation engine automatically when unset).
# ANTHROPIC_API_KEY=
