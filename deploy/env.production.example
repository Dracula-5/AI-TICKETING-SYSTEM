# /opt/nexadesk/.env on the VM — created by deploy/bootstrap-vm.sh with fresh
# random secrets. Never commit the real file. Values here are placeholders.

# --- where it runs ------------------------------------------------------------
DOMAIN=nexadesk.example.com          # DNS A/AAAA record must point at the VM
ACME_EMAIL=you@example.com           # Let's Encrypt expiry notices
ENVIRONMENT=production               # or "staging" for a demo/staging stack
REGISTRY=ghcr.io/your-github-user    # where CI pushes images
API_WORKERS=2
# Per API process: requests in flight beyond this get an immediate 503 instead of queueing
# (measured: p95 at overload 43 s -> 0.82 s, reports/load/README.md). Empty = no cap.
API_LIMIT_CONCURRENCY=30
# Database pool per process; keep API_WORKERS x (size + overflow) + worker below PostgreSQL's 100.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10

# --- secrets (generated) -------------------------------------------------------
SECRET_KEY=generate-with-openssl-rand-base64-48
POSTGRES_PASSWORD=generate-with-openssl-rand-base64-24
POSTGRES_USER=nexadesk
POSTGRES_DB=nexadesk
# Bearer token Prometheus presents on /metrics (API and worker). Required.
METRICS_TOKEN=generate-with-openssl-rand-base64-32

# --- email (optional; without it, links are only visible in the outbox table) ---
EMAIL_BACKEND=smtp
EMAIL_FROM=NexaDesk AI <no-reply@nexadesk.example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- attachments: local volume (default) or S3-compatible object storage ------
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- error monitoring (optional, Sentry-compatible DSN) -------------------------
SENTRY_DSN=

# --- public demo organization (optional) ----------------------------------------
# Password for the seeded demo accounts; also baked into the web build so the
# landing page can offer "Continue as …" buttons. Leave empty for no demo login.
DEMO_PASSWORD=

# --- AI -------------------------------------------------------------------------
# Triage recommendations and knowledge-base search run on the VM's CPU with the
# embedding model baked into the backend image (no external calls).
AI_ENABLED=true
# Embedding model threads (0 = one per core) and texts per model call. On a host
# with a fraction of a CPU or under 1 GB RAM use 1 and 4 (docs/deployment.md, Render).
# EMBEDDING_THREADS=0
# EMBEDDING_BATCH_SIZE=32
# Cross-encoder reranking for knowledge-base search ("none" to disable).
KB_RERANK_MODEL=none
# Generated text (ticket summaries, reply drafts, knowledge-base answers) is OFF
# unless both are set. Setting them sends ticket and article text to the
# provider — decide that explicitly. Prices (USD per million tokens, from the
# provider's price list) are optional; without them cost is recorded as unknown.
LLM_PROVIDER=none                    # none | anthropic | openai
LLM_API_KEY=
LLM_MODEL=                           # e.g. claude-haiku-4-5-20251001
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# --- observability (optional: docker compose --profile observability up -d) ---
# Grafana listens on 127.0.0.1:3000 only — reach it through an SSH tunnel.
GRAFANA_ADMIN_PASSWORD=generate-with-openssl-rand-base64-18
