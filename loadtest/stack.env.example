# Environment for a LOCAL load-test stack (copy to the repository root as .env,
# which is gitignored). Uses the production compose file with DOMAIN=localhost.
DOMAIN=localhost
ACME_EMAIL=
ENVIRONMENT=staging
REGISTRY=local
IMAGE_TAG=loadtest
API_WORKERS=2
SECRET_KEY=replace-with-openssl-rand-base64-48-output
POSTGRES_PASSWORD=replace-with-random
POSTGRES_USER=nexadesk
POSTGRES_DB=nexadesk
METRICS_TOKEN=replace-with-at-least-24-random-characters
GRAFANA_ADMIN_PASSWORD=replace-with-random
# Load tests come from one IP; the per-IP limiter (still in the request path,
# backed by Redis) is raised so it measures capacity, not the limit.
RATE_LIMIT_DEFAULT=1000000/minute
# Tokens minted by seed_volume must outlive the run.
ACCESS_TOKEN_EXPIRE_MINUTES=240
EMAIL_BACKEND=console
AI_ENABLED=true
KB_RERANK_MODEL=none
LLM_PROVIDER=none
