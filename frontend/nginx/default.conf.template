# Serves the built SPA and proxies /api to the backend, so browser, SPA and
# API share one origin (the refresh cookie stays first-party, no CORS needed).
# In the VM deployment, Caddy terminates TLS in front of this container and
# routes /api itself. On Render (two web services) this proxy is the path:
# API_UPSTREAM=https://<api-service>.onrender.com.
#
# Template: the nginx image substitutes ${PORT}, ${API_UPSTREAM} and
# ${NGINX_LOCAL_RESOLVERS} at start-up. The upstream is a variable resolved through DNS at request time,
# so a hosted API whose IP changes keeps working without restarting nginx.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

# Keep the original scheme when a platform load balancer terminated TLS first.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;
  client_max_body_size 11m;  # attachments are capped at 10 MB by the API

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  # Security headers are added per SPA location (see security-headers.conf);
  # /api responses carry the backend's own headers.

  resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

  location /api/ {
    set $api_upstream ${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    # Host of the upstream itself: hosted platforms route by Host/SNI.
    proxy_set_header Host $proxy_host;
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # Also covers a sleeping free-tier API waking up (about a minute on Render).
    proxy_read_timeout 120s;
  }

  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
