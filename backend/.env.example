# Copy to backend/.env for local development. Never commit a real .env.

ENVIRONMENT=development            # development | test | staging | production

# SQLite for zero-setup local dev; PostgreSQL (docker compose) matches production.
DATABASE_URL=sqlite:///./nexadesk.db
# DATABASE_URL=postgresql://nexadesk:nexadesk@localhost:5432/nexadesk
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Staging/production refuse to start with the development default.
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Only needed when the SPA runs on a different origin (Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
COOKIE_SECURE=false                # must be true in staging/production (HTTPS)

# console: emails are stored in the outbox table (and /api/v1/dev/outbox in dev)
# smtp: delivered via the SMTP_* settings below
EMAIL_BACKEND=console
EMAIL_FROM=NexaDesk AI <no-reply@nexadesk.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

ATTACHMENT_DIR=./var/attachments
SLA_SWEEP_ENABLED=true
SLA_SWEEP_INTERVAL_SECONDS=60

# Password for the shared demo accounts created by `python -m app.scripts.seed_demo`.
# DEMO_PASSWORD=

# AI: embeddings run locally (downloaded on first use to MODEL_CACHE_DIR or the
# FastEmbed default cache). Generated text stays off unless LLM_PROVIDER and
# LLM_API_KEY are both set — see deploy/env.production.example.
AI_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MODEL_CACHE_DIR=
KB_RERANK_MODEL=none
LLM_PROVIDER=none
# LLM_API_KEY=
# LLM_MODEL=
